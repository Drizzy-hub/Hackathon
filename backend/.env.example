# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_QA_MODEL=gpt-4o
OPENAI_LANGUAGE_MODEL=gpt-4o-mini
OPENAI_ASR_MODEL=whisper-1

# --- ElevenLabs ---
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_MODEL=eleven_v3
# Fallback voice used when a per-language voice is not set.
ELEVENLABS_DEFAULT_VOICE=
# Per-language voice IDs (preferred).
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_FR=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_YO=

# --- Session store ---
SESSION_TTL_SECONDS=900
MAX_IMAGE_BYTES=10485760
HTTP_TIMEOUT_SECONDS=60

# --- CORS ---
# Comma-separated origins. Include your deployed frontend URL in prod.
ALLOWED_ORIGINS=http://localhost:3000
